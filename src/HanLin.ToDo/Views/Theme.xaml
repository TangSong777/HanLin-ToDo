<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Calendar.xaml"/>
    <ResourceDictionary Source="Menus.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="SoftButton" TargetType="Button">
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="MinHeight" Value="29"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border CornerRadius="7" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="Hover" CornerRadius="7" Background="{DynamicResource HoverBrush}" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="Press" CornerRadius="7" Background="{DynamicResource PressBrush}" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="Caption" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
            <Border x:Name="FocusRing" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="Tag" Value="Primary">
              <Setter TargetName="Hover" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
              <Setter TargetName="Press" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Press" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Caption" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SoftCheck" TargetType="CheckBox">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource CheckBrush}" Background="{DynamicResource SurfaceBrush}"/>
            <Path x:Name="Tick" Opacity="0" Data="M 0 4 L 3 7 L 8 1" Width="8" Height="8"
                  StrokeThickness="1.35" Stroke="{DynamicResource AccentInkBrush}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Tick" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SoftTaskRow" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SoftTaskHandle" TargetType="Thumb">
    <Setter Property="Width" Value="21"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource CheckBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Handle" CornerRadius="6" Background="Transparent" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
              <Ellipse Fill="{TemplateBinding Foreground}" Width="3" Height="3"/>
              <Ellipse Fill="{TemplateBinding Foreground}" Width="3" Height="3" Margin="0,2"/>
              <Ellipse Fill="{TemplateBinding Foreground}" Width="3" Height="3"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Handle" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Handle" Property="Background" Value="{DynamicResource PressBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Handle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SoftInput" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <!-- TextBoxBase applies its padding and scroll settings to the content host. -->
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="VerticalContentAlignment" Value="Top"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NoteVerticalScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}"/>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb MinHeight="24">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border x:Name="TrackThumb" Margin="2,0" CornerRadius="3"
                            Background="{DynamicResource EdgeBrush}"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="TrackThumb" Property="Background" Value="{DynamicResource CheckBrush}"/>
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="TrackThumb" Property="Background" Value="{DynamicResource CheckBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}"/>
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NoteScroll" TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Margin="0,5"
                       Style="{StaticResource NoteVerticalScrollBar}"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{TemplateBinding VerticalOffset}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SoftDatePicker" TargetType="DatePicker">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="CalendarStyle" Value="{StaticResource SoftCalendar}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Grid x:Name="PART_Root">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
              </Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" Padding="6,4"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                 AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"/>
              <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource SoftButton}" Padding="0"
                      ToolTip="{TemplateBinding Tag}" AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                <Path Data="M 2,4 H 12 V 12 H 2 Z M 2,6.5 H 12 M 4.5,2.5 V 5 M 9.5,2.5 V 5"
                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.25"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
              </Button>
              <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}"
                     AllowsTransparency="False" PopupAnimation="None" StaysOpen="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuickDatePicker" TargetType="DatePicker" BasedOn="{StaticResource SoftDatePicker}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid x:Name="PART_Root">
            <DatePickerTextBox x:Name="PART_TextBox" Visibility="Collapsed"/>
            <Button x:Name="PART_Button" Style="{StaticResource SoftButton}" Padding="0"
                    ToolTip="{TemplateBinding Tag}" AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{TemplateBinding Background}">
              <Path Data="M 2,4 H 12 V 12 H 2 Z M 2,6.5 H 12 M 4.5,2.5 V 5 M 9.5,2.5 V 5"
                    Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.25"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
            </Button>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}"
                   AllowsTransparency="False" PopupAnimation="None" StaysOpen="False"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SoftTimeSelect" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="MinHeight" Value="27"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="23"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource SoftInput}"
                       Background="Transparent" BorderThickness="0" Padding="3,1" MinHeight="0"
                       Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center"
                       TextAlignment="Center"/>
              <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ArrowHit" Background="Transparent" CornerRadius="4" Margin="1">
                      <Path Data="M 1,2 L 5,6 L 9,2" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.25"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ArrowHit" Property="Background" Value="{DynamicResource HoverBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Focusable="False" AllowsTransparency="False"
                     Placement="Bottom" PlacementTarget="{Binding ElementName=Chrome}"
                     PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                        BorderThickness="1" Padding="3"
                        MinWidth="{TemplateBinding ActualWidth}" RenderOptions.ClearTypeHint="Enabled">
                  <ScrollViewer CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.52"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
